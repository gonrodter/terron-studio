{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^[eE][nN].*"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    { "source": "/", "destination": "/es", "permanent": false },
    { "source": "/projects", "destination": "/es/projects", "permanent": true },
    {
      "source": "/projects/:slug",
      "destination": "/es/projects/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/es/projects", "destination": "/es/projects/index.html" },
    { "source": "/en/projects", "destination": "/en/projects/index.html" },
    {
      "source": "/es/projects/aparicio-alemany",
      "destination": "/es/projects/aparicio-alemany/index.html"
    },
    {
      "source": "/en/projects/aparicio-alemany",
      "destination": "/en/projects/aparicio-alemany/index.html"
    },
    {
      "source": "/es/projects/ducati-w93",
      "destination": "/es/projects/ducati-w93/index.html"
    },
    {
      "source": "/en/projects/ducati-w93",
      "destination": "/en/projects/ducati-w93/index.html"
    },
    {
      "source": "/es/projects/collecta",
      "destination": "/es/projects/collecta/index.html"
    },
    {
      "source": "/en/projects/collecta",
      "destination": "/en/projects/collecta/index.html"
    },
    {
      "source": "/es/projects/burntab",
      "destination": "/es/projects/burntab/index.html"
    },
    {
      "source": "/en/projects/burntab",
      "destination": "/en/projects/burntab/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
