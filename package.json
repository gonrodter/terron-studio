{
  "name": "terron-studio-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build --manifest",
    "build:ssr": "vite build --ssr src/entry-server.js --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8080"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/comic-neue": "^5.2.7",
    "@fontsource/phudu": "^5.2.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "posthog-js": "^1.407.3",
    "vite": "^6.3.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17"
  }
}
